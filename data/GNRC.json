stributors; and directly to end users. Generac Holdings Inc. was founded in 1959 and is based in Waukesha, Wisconsin.", "marketCap": 11627318272, "beta": 1.845, "divYield": 0.0, "pe": 38.877712, "ps": 2.5171943, "debtToEquity": 47.187, "prices": [["2016-11-21", 42.0], ["2016-11-28", 41.16], ["2016-12-05", 42.95], ["2016-12-12", 41.48], ["2016-12-19", 42.09], ["2016-12-26", 40.74], ["2017-01-02", 40.71], ["2017-01-09", 37.99], ["2017-01-16", 38.6], ["2017-01-23", 40.31], ["2017-01-30", 40.6], ["2017-02-06", 42.21], ["2017-02-13", 40.45], ["2017-02-20", 39.3], ["2017-02-27", 39.47], ["2017-03-06", 38.66], ["2017-03-13", 38.46], ["2017-03-20", 37.31], ["2017-03-27", 37.28], ["2017-04-03", 35.89], ["2017-04-10", 35.05], ["2017-04-17", 35.99], ["2017-04-24", 35.17], ["2017-05-01", 36.08], ["2017-05-08", 35.14], ["2017-05-15", 35.22], ["2017-05-22", 34.83], ["2017-05-29", 35.95], ["2017-06-05", 36.28], ["2017-06-12", 35.6], ["2017-06-19", 35.9], ["2017-06-26", 36.13], ["2017-07-03", 36.14], ["2017-07-10", 36.03], ["2017-07-17", 36.37], ["2017-07-24", 36.06], ["2017-07-31", 38.22], ["2017-08-07", 37.39], ["2017-08-14", 36.41], ["2017-08-21", 38.59], ["2017-08-28", 40.66], ["2017-09-04", 41.8], ["2017-09-11", 45.28], ["2017-09-18", 45.38], ["2017-09-25", 45.93], ["2017-10-02", 49.03], ["2017-10-09", 50.58], ["2017-10-16", 50.61], ["2017-10-23", 51.98], ["2017-10-30", 50.2], ["2017-11-06", 49.84], ["2017-11-13", 50.31], ["2017-11-20", 48.76], ["2017-11-27", 48.73], ["2017-12-04", 48.86], ["2017-12-11", 48.94], ["2017-12-18", 50.36], ["2017-12-25", 49.52], ["2018-01-01", 50.41], ["2018-01-08", 49.27], ["2018-01-15", 51.64], ["2018-01-22", 51.14], ["2018-01-29", 49.24], ["2018-02-05", 46.47], ["2018-02-12", 45.69], ["2018-02-19", 45.39], ["2018-02-26", 43.72], ["2018-03-05", 47.61], ["2018-03-12", 47.39], ["2018-03-19", 44.47], ["2018-03-26", 45.91], ["2018-04-02", 45.3], ["2018-04-09", 45.97], ["2018-04-16", 45.77], ["2018-04-23", 45.03], ["2018-04-30", 46.03], ["2018-05-07",